{
  "name": "bocal-apple-capacitor",
  "version": "0.0.0",
  "private": true,
  "description": "Unsigned Capacitor 8 iOS/iPadOS host for the Bocal standalone bundle. Scaffold; nothing here has been built in Xcode.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "stage": "bash scripts/stage_bundle.sh",
    "sync": "bash scripts/stage_bundle.sh && cap sync ios",
    "lint": "python3 -I lint.py",
    "test": "python3 -I -m unittest discover -s . -p 'test_*.py'"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
