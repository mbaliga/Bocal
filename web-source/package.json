{
  "name": "bocal-music",
  "version": "1.0.0-rc.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "prebuild": "node scripts/sync-handoff.mjs",
    "build": "vinext build && bash scripts/validate-artifact.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test tests/*.test.mjs",
    "test:dist": "npm run build && node --test tests/*.dist-test.mjs",
    "test:e2e": "node --import tsx tests/e2e-smoke.mjs",
    "test:theme": "npm run preview:standalone && node tests/theme.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern preview-dist",
    "preview:standalone": "node scripts/sync-handoff.mjs && vite build --config vite.preview.config.ts && node scripts/inline-preview-assets.mjs && node scripts/check-bundle-syntax.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "acorn": "8.18.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-unused-imports": "^4.1.4",
    "playwright": "1.56.1",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "4.133.0"
  },
  "type": "module",
  "displayName": "Bocal"
}
