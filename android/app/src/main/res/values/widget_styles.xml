<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget text and controls. Sizes are in sp so they follow the
     system font scale; every text view also sets maxLines and ellipsizes. -->
<resources>
    <style name="BocalWidget" />

    <style name="BocalWidget.Root">
        <item name="android:background">@drawable/widget_background</item>
        <item name="android:padding">@dimen/widget_padding</item>
    </style>

    <style name="BocalWidget.Kicker">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BocalWidget.Value">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BocalWidget.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BocalWidget.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BocalWidget.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BocalWidget.Progress" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/widget_progress</item>
        <item name="android:indeterminate">false</item>
        <item name="android:max">100</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
    </style>

    <style name="BocalWidget.DayBar" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/widget_day_bar</item>
        <item name="android:indeterminate">false</item>
        <item name="android:minHeight">12dp</item>
        <item name="android:maxHeight">400dp</item>
    </style>

    <!-- A pad: a whole-width button with a 48 dp minimum touch target. -->
    <style name="BocalWidget.Pad">
        <item name="android:background">@drawable/widget_pad</item>
        <item name="android:minHeight">@dimen/widget_touch</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
