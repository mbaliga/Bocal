<?xml version="1.0" encoding="utf-8"?>
<!-- Resizable from about 2x1 to full width: small, medium and large layouts (docs/widgets.md).
     No polling: Bocal redraws its widgets when the web app publishes new practice data,
     and once after midnight, when "the last seven days" moves on. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_log_description"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_log"
    android:previewLayout="@layout/widget_log_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
