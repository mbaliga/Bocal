<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/BocalWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/widget_kicker"
        style="@style/BocalWidget.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_week_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_value"
            style="@style/BocalWidget.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/widget_goal"
            style="@style/BocalWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@style/BocalWidget.Progress"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no" />

    <!-- Optional detail takes the spare height (and is the first thing squeezed);
         the as-of / stale line below it is fixed, so it is never the one lost. -->
    <TextView
        android:id="@+id/widget_caption"
        style="@style/BocalWidget.Meta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="@color/widget_ink" />

    <TextView
        android:id="@+id/widget_footer"
        style="@style/BocalWidget.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1" />
</LinearLayout>
