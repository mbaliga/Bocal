<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    style="@style/BocalWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The eye is its own 48 dp tap target, so it stays a separate view. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables">

        <TextView
            android:id="@+id/widget_kicker"
            style="@style/BocalWidget.Kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_studying_name" />

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="@dimen/widget_touch"
            android:layout_height="@dimen/widget_touch"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="-12dp"
            android:padding="12dp"
            android:contentDescription="@string/widget_studying_show"
            android:src="@drawable/widget_icon_eye_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_title"
        style="@style/BocalWidget.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@style/BocalWidget.Progress"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_meta"
        style="@style/BocalWidget.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1" />
</LinearLayout>
