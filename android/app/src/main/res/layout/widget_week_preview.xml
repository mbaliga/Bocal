<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+). Sample content only; never drawn with real data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/BocalWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/BocalWidget.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_week_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            style="@style/BocalWidget.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_week_value" />

        <TextView
            style="@style/BocalWidget.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_preview_week_goal"
            android:textColor="@color/widget_muted" />
    </LinearLayout>

    <ProgressBar
        style="@style/BocalWidget.Progress"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:progress="70" />

    <TextView
        style="@style/BocalWidget.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_week_caption" />
</LinearLayout>
