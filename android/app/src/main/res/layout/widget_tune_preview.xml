<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+). Sample content only; never drawn with real data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/BocalWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/BocalWidget.Kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_tune_name" />

    <TextView
        style="@style/BocalWidget.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_instrument" />

    <TextView
        style="@style/BocalWidget.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_reference" />

    <TextView
        style="@style/BocalWidget.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_transposition" />
</LinearLayout>
