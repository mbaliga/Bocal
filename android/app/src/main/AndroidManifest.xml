<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bocal"
        android:usesCleartextTraffic="false">
        <!-- Compose and CSS resize the existing WebView. Recreating the Activity
             here discards live JS state, an in-progress recording and Save As.
             Process death is different: durable data restores on a cold launch. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenLayout|orientation|screenSize|keyboard|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets (docs/widgets.md). Providers are exported so any launcher
             can bind them; they redraw from the summary the web app publishes and never
             touch the network. TIME_SET, TIMEZONE_CHANGED and LOCALE_CHANGED are system
             broadcasts that redraw dates and words. -->
        <receiver
            android:name=".widget.ThisWeekWidget"
            android:exported="true"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <receiver
            android:name=".widget.TuneWidget"
            android:exported="true"
            android:label="@string/widget_tune_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tune_info" />
        </receiver>
        <receiver
            android:name=".widget.NowStudyingWidget"
            android:exported="true"
            android:label="@string/widget_studying_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_studying_info" />
        </receiver>
        <receiver
            android:name=".widget.PracticeLogWidget"
            android:exported="true"
            android:label="@string/widget_log_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_log_info" />
        </receiver>
        <receiver
            android:name=".widget.PulseWidget"
            android:exported="true"
            android:label="@string/widget_pulse_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pulse_info" />
        </receiver>
        <receiver
            android:name=".widget.InstrumentWidget"
            android:exported="true"
            android:label="@string/widget_instrument_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_instrument_info" />
        </receiver>
        <!-- The widgets' own actions (title toggle, midnight redraw): Bocal's pending intents only. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
    </application>
</manifest>
