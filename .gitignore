# Dependencies
node_modules/

# Build caches and framework output
# NOTE: web-standalone/dist/ is intentionally tracked — it is the
# ready-to-host static build referenced by the 0.2 handoff.
.next/
.turbo/
.vite/
*.tsbuildinfo

# vinext / Sites runtime scratch (see web-source-v6/README.md)
.sites-runtime/
.wrangler/
.vinext/
.openai/
!web-source/.openai/
!web-source/.openai/hosting.json

# web-source build output — vite build (dist/) and the standalone on-device
# preview (preview-dist/, see web-source/preview/README.md). Both regenerate
# from source; neither is meant to be committed.
web-source/dist/
web-source/preview-dist/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
